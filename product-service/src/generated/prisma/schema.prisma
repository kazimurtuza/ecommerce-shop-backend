generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parent_id   String?    @db.Uuid
  name        String
  slug        String     @unique
  description String     @default("")
  image       String     @default("")
  status      String     @default("active")
  sort_order  Int        @default(0)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  @@index([parent_id])
  @@map("categories")
}

model Attribute {
  id         String           @id @default(uuid()) @db.Uuid
  name       String
  slug       String           @unique
  input_type String           @default("select")
  values     AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id           String    @id @default(uuid()) @db.Uuid
  attribute_id String    @db.Uuid
  value        String
  metadata     Json?
  attribute    Attribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@index([attribute_id])
  @@map("attribute_values")
}
