# PostgreSQL Database Connection URL for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db?schema=public"
JWT_SECRET="your_jwt_secret_key"

# SMS Gateway Configuration
SMS_API_KEY="your_sms_gateway_api_key"
SMS_SENDER_ID="your_sender_id_if_required"
SMS_GATEWAY_URL="http://bulksmsbd.net/api/smsapi"
